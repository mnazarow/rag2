# Сгенерировано: python settings_schema.py env


# ==== Источники ===================================================
# Папка базы знаний. Корень корпоративной базы. Индексатор обходит её целиком, включая вложенные папки. Первый уровень папок становится «разделом», второй — «брендом»: по ним работают роли и фильтры.
# Рекомендация: Указывайте именно корень BD, а не подпапку: имена разделов в ROLE_SECTIONS должны совпадать с папками первого уровня.
KB_ROOT=

# Папка индекса. Куда складывать базу индекса, векторы, кэш и распакованные архивы.
# Рекомендация: Держите на локальном диске. На сетевой или примонтированной папке SQLite не сможет работать в режиме WAL и будет тормозить.
DATA_DIR=./data

# Максимальный размер файла, МБ. Файлы больше этого размера не разбираются как текст (видео и архивы под ограничение не попадают).
# Рекомендация: 120 МБ покрывает все каталоги. Увеличивать стоит, только если в базе есть очень большие PDF-сборники.
MAX_FILE_MB=120


# ==== Нетекстовые материалы =======================================
# Карточки для чертежей, фото и видео. Создавать текстовую карточку для каждого нетекстового файла: тип, бренд, товарная линейка, имя файла, соседние файлы. Так чертёж или фотография становятся находимыми по названию модели и привязываются к своей папке.
# Рекомендация: Включено. Выключать имеет смысл, только если нужен индекс исключительно по тексту документов.
ASSET_CARDS=True

# Распаковывать архивы. Внутри RAR и ZIP в базе лежат сертификаты, старые паспорта и модели Revit. Без распаковки они выпадают из индекса целиком.
# Рекомендация: Включено. Нужен установленный распаковщик: bsdtar, p7zip, unar или unrar.
EXTRACT_ARCHIVES=True

# Глубина вложенности архивов. Сколько уровней «архив внутри архива» разбирать.
# Рекомендация: 3 достаточно. Больше — только если знаете, что вложенность глубже.
ARCHIVE_MAX_DEPTH=3

# Предел степени сжатия. Защита от архивов-бомб: если распакованный объём превышает размер архива больше чем во столько раз, архив пропускается.
# Рекомендация: 200 — безопасное значение для обычных рабочих архивов.
ARCHIVE_MAX_RATIO=200


# ==== Видео и аудио ===============================================
# Распознавание речи. Чем расшифровывать звуковую дорожку видео. Расшифровка режется на куски с таймкодами, и бот отвечает ссылкой на конкретную минуту.
# Рекомендация: faster-whisper — быстрее и экономнее оригинального whisper. На записях с шумом (съёмка производства) whisper устойчивее российских моделей; на чистой студийной речи разница невелика.
# Варианты: none, faster-whisper, whisper, yandex, sber
ASR_PROVIDER=none

# Модель распознавания. Имя модели для выбранного провайдера.
# Рекомендация: large-v3-turbo — разумный баланс. На слабой машине — medium или small, но качество на технических терминах заметно упадёт.
ASR_MODEL=large-v3-turbo

# Длина смыслового куска расшифровки, секунд. На какие отрезки резать расшифровку. Слишком мелкие куски плохо ищутся: во фразе «а теперь нажимаем сюда» нет искомых слов.
# Рекомендация: 45–90 секунд для обучающих видео, 30–45 для коротких инструкций.
ASR_SEGMENT_SECONDS=60


# ==== Изображения =================================================
# Описание изображений. Модель, которая описывает фотографии словами и считывает надписи с шильдиков. Без этого фото остаются находимыми только по имени файла.
# Рекомендация: openai-совместимый endpoint с моделью Qwen3-VL: она надёжнее прочих работает с кириллицей и не подменяет русские буквы латинскими.
# Варианты: none, openai, gigachat, yandex, local
VISION_PROVIDER=none

# Модель описания изображений. Имя модели зрения у выбранного провайдера.
# Рекомендация: Версия на 8 млрд параметров дешевле и почти не уступает на простых фотографиях продукции.
VISION_MODEL=qwen/qwen3-vl-32b-instruct


# ==== Чертежи =====================================================
# Путь к ODA File Converter. Бесплатный конвертер DWG в DXF. Нужен, чтобы вытащить надписи основной надписи из чертежей, у которых нет PDF-двойника.
# Рекомендация: Сначала проверьте, есть ли рядом с DWG одноимённый PDF — из него текст берётся бесплатно и надёжнее. Конвертер нужен для остальных.
ODA_CONVERTER=


# ==== Чанкинг =====================================================
# Целевой размер фрагмента, символов. На куски какого размера резать документ. Слишком крупные куски размывают смысл и раздувают стоимость, слишком мелкие теряют контекст.
# Рекомендация: 1200–1600 для технической документации. Если модель эмбеддингов принимает всего 512 токенов (например GigaChat Embeddings) — снизьте до 800, иначе конец фрагмента будет обрезан.
CHUNK_TARGET_CHARS=1400

# Перекрытие фрагментов, символов. Сколько символов конца предыдущего куска повторить в следующем, чтобы предложение на границе не потерялось.
# Рекомендация: 10–15 % от размера фрагмента.
CHUNK_OVERLAP_CHARS=200

# Контекст фрагмента через модель. Дописывать к каждому фрагменту сгенерированное моделью пояснение, к чему он относится. Повышает качество поиска, но требует одного обращения к модели на каждый фрагмент при индексации.
# Рекомендация: Выключено на старте: детерминированная приставка из пути и заголовка уже закрывает большую часть эффекта бесплатно. Включать после того, как индекс стабилизируется.
CONTEXTUAL_CHUNKS=False


# ==== Модели ======================================================
# Провайдер смыслового поиска. Чем превращать текст в векторы. Это второй канал поиска: текстовый канал находит точные слова и артикулы, смысловой — вопросы, заданные не теми словами, что в документе («какая производительность» → «подача, м³/ч»).
# Рекомендация: lsa — модель обучается на вашей же базе за минуты, ничего не качает, работает на процессоре: это рабочий вариант по умолчанию. onnx с USER-bge-m3 — качество выше, нужны файлы модели (см. документацию). local — то же, но требует torch. hashing — заглушка: смысловой близости не даёт, поиск фактически остаётся на одном текстовом канале.
# Варианты: lsa, onnx, local, gigachat, yandex, openai, hashing
EMBEDDINGS_PROVIDER=lsa

# Модель эмбеддингов. Имя модели у выбранного провайдера (для lsa не используется).
# Рекомендация: deepvk/USER-bge-m3 для русского; BAAI/bge-m3 как универсальная.
EMBEDDINGS_MODEL=

# Измерений в собственной модели. Размерность смыслового пространства модели, обучаемой на вашей базе. Больше измерений — тоньше различия, но дольше обучение и больше файл модели.
# Рекомендация: 256 для базы в десятки тысяч фрагментов. 128 — если фрагментов меньше пяти тысяч, 384 — если больше двухсот тысяч.
LSA_DIM=256

# Размер словаря модели. Сколько самых частых слов оставить. Редкие слова отбрасываются: они почти не помогают поиску, но заметно увеличивают расчёт.
# Рекомендация: 60000 покрывает техническую лексику плюс названия моделей. Уменьшайте, если обучение не влезает в память.
LSA_MAX_FEATURES=60000

# Минимальная встречаемость слова. Слово попадает в словарь, если встретилось хотя бы в стольких фрагментах. Единичные опечатки так отсеиваются сами.
# Рекомендация: 2 — разумно почти всегда. 1 стоит ставить только на очень маленькой базе.
LSA_MIN_DF=2

# Порог устаревания модели. Насколько база может вырасти после обучения, прежде чем в журнал попадёт напоминание переобучить модель. Слова, появившиеся после обучения, модели неизвестны.
# Рекомендация: 0.35 — то есть при росте базы на треть. Для быстро растущей базы ставьте 0.2 и переобучайте по расписанию.
LSA_STALE_RATIO=0.35

# Файл модели ONNX. Путь к model.onnx готовой модели эмбеддингов. Позволяет запустить BGE-M3 или USER-bge-m3 без установки torch — на процессоре и без интернета на сервере.
# Рекомендация: Экспортируйте на машине с интернетом: optimum-cli export onnx --model deepvk/USER-bge-m3 ./user-bge-m3-onnx и перенесите папку на сервер.
ONNX_MODEL_PATH=

# Папка токенизатора ONNX. Где лежат tokenizer.json или vocab.txt. Пусто — берётся папка рядом с файлом модели.
# Рекомендация: Оставьте пустым, если экспортировали модель целиком в одну папку.
ONNX_TOKENIZER_DIR=

# Способ свёртки токенов. Как получить один вектор из векторов отдельных токенов.
# Рекомендация: mean для моделей семейства BGE и E5, cls для ru-en-RoSBERTa. Ошибка здесь не ломает поиск, но заметно ухудшает его — сверьтесь с карточкой модели.
# Варианты: mean, cls
ONNX_POOLING=mean

# Максимум токенов на фрагмент. Длинные фрагменты обрезаются. Больше — точнее, но медленнее.
# Рекомендация: 512 совпадает с длиной фрагмента при настройках по умолчанию.
ONNX_MAX_TOKENS=512

# Провайдер генерации. Какая модель формулирует ответ по найденным фрагментам.
# Рекомендация: gigachat или yandex для российского контура; openai — для любого OpenAI-совместимого endpoint, включая собственный vLLM. echo — заглушка без модели, собирает ответ из найденных предложений.
# Варианты: echo, gigachat, yandex, openai
LLM_PROVIDER=echo

# Модель генерации. Имя модели у выбранного провайдера.
# Рекомендация: GigaChat-2-Max для качества, GigaChat-2-Pro для экономии. Разброс качества внутри одной линейки велик — сверяйтесь с версией.
LLM_MODEL=

# Температура. Насколько модель может отклоняться от буквального текста.
# Рекомендация: 0.0–0.2. Для справочного ассистента творчество вредно.
LLM_TEMPERATURE=0.1


# ==== Поиск =======================================================
# Фрагментов в ответ модели. Сколько найденных кусков передаётся модели для формулировки ответа.
# Рекомендация: 5–8. Больше — дороже и повышает риск, что модель возьмёт не тот фрагмент.
SEARCH_TOP_K=6

# Кандидатов из каждого канала. Сколько результатов брать отдельно из текстового и векторного поиска до их объединения.
# Рекомендация: 30–60. Меньше — можно потерять нужное, больше — медленнее.
SEARCH_CANDIDATES=40

# Вес релевантности против свежести. Итоговая оценка = ALPHA × релевантность + (1−ALPHA) × свежесть. Чем ниже значение, тем сильнее свежие документы вытесняют старые.
# Рекомендация: 0.85 — свежесть учитывается, но не побеждает смысл. Для прайсов имеет смысл 0.7.
RECENCY_ALPHA=0.85

# Период полураспада свежести, дней. Через столько дней вклад свежести документа уменьшается вдвое.
# Рекомендация: 540 (полтора года) для документации, 120 для прайсов.
RECENCY_HALF_LIFE_DAYS=540

# Порог уверенности. Ниже этой оценки бот отвечает «в базе нет данных» вместо догадки. Ретривер всегда что-нибудь возвращает — этот порог отделяет находку от случайного совпадения.
# Рекомендация: Подбирается по контрольному набору вопросов: поднимайте, пока бот не перестанет выдумывать, но ещё отвечает на реальные вопросы.
MIN_CONFIDENCE=0.012

# Переранжирование. Поиск отбирает двадцать кандидатов дёшево и приблизительно, а переранжирование заново читает каждую пару «вопрос + фрагмент» целиком и оставляет пять лучших. Именно этот шаг убирает случаи, когда нужный документ нашёлся, но оказался не на первом месте и не попал в ответ.
# Рекомендация: lexical работает сразу, без моделей и интернета, и снимает заметную часть промахов. onnx с BGE-reranker-v2-m3 точнее, нужен файл модели на три гигабайта и примерно полсекунды на запрос. Восьмимиллиардную версию не берите: задержка около пяти секунд для чата неприемлема.
# Варианты: none, lexical, onnx, local, openai
RERANKER_PROVIDER=lexical

# Сколько кандидатов пересортировывать. Переранжирование применяется к первым N результатам гибридного поиска. Остальные сохраняют исходный порядок.
# Рекомендация: 20 — стандарт. Больше 50 почти не улучшает выдачу, но линейно увеличивает задержку ответа.
RERANKER_TOP_N=20

# Вес переранжирования. Насколько оценка кросс-энкодера перевешивает исходную оценку поиска. 1.0 — доверять только ему, 0.0 — не учитывать вовсе.
# Рекомендация: 0.8 оставляет реранкеру решающий голос, но не даёт затереть приоритет свежести и точные попадания по артикулу. Снизьте до 0.5, если начали всплывать устаревшие прайсы.
RERANKER_WEIGHT=0.8

# Размер пачки переранжирования. Сколько пар «вопрос + фрагмент» считать за один вызов модели.
# Рекомендация: 16 для процессора, 32–64 для видеокарты.
RERANKER_BATCH=16

# Таймаут переранжирования, секунд. Если модель не ответила за это время, выдача отдаётся в исходном порядке. Ответ пользователю приходит в любом случае.
# Рекомендация: 20 секунд. Уменьшите до 5, если реранкер внешний и канал ненадёжен.
RERANKER_TIMEOUT=20.0

# Файл реранкера ONNX. Путь к model.onnx кросс-энкодера для RERANKER_PROVIDER=onnx.
# Рекомендация: optimum-cli export onnx --model BAAI/bge-reranker-v2-m3 ./reranker-onnx
RERANKER_ONNX_PATH=

# Кэшировать оценки переранжирования. Повторный или похожий вопрос не пересчитывает те же пары заново.
# Рекомендация: Включено. Кэш живёт в памяти процесса и очищается при перезапуске.
RERANKER_CACHE=True


# ==== Telegram ====================================================
# Токен бота. Выдаётся при создании бота у @BotFather.
# Рекомендация: Храните в .env, не в репозитории. При утечке — отзывайте у BotFather.
TELEGRAM_BOT_TOKEN=

# Прокси для Telegram. Через какой прокси ходить к серверам Telegram. Поддерживаются socks5 и http. Пусто — напрямую.
# Рекомендация: socks5 обычно стабильнее http для длинных опросов. Для socks5 нужен пакет httpx[socks].
TELEGRAM_PROXY=

# Разрешённые пользователи. Числовые идентификаторы сотрудников через запятую. Пустое поле означает «пускать всех» — только для теста.
# Рекомендация: Заполняйте обязательно. Свой идентификатор сотрудник узнаёт командой /whoami.
TELEGRAM_ALLOWED_IDS=

# Эксперты и администраторы. Кто получает уведомления о плохих ответах и может добавлять выверенные ответы командой /expert.
# Рекомендация: Два-три человека по направлениям продукции.
TELEGRAM_ADMIN_IDS=


# ==== Сеть ========================================================
# Прокси для моделей. Через какой прокси обращаться к API моделей.
# Рекомендация: Нужен, только если сервер не имеет прямого выхода в интернет.
LLM_PROXY=

# Прокси для обхода сайтов. Через какой прокси ходить к сайтам производителей.
# Рекомендация: Полезно, чтобы обход не шёл с того же адреса, что и офис.
CRAWLER_PROXY=


# ==== Сайты и веб-поиск ===========================================
# Предел страниц за обход. Сколько страниц забирать с одного сайта за один проход.
# Рекомендация: Начните с 200–500. Полный каталог производителя может быть в разы больше — увеличивайте после первого прогона.
CRAWL_MAX_PAGES=500

# Пауза между запросами, секунд. Насколько вежливо обходить чужой сайт.
# Рекомендация: 1–3 секунды. Меньше — риск получить бан по адресу и испортить отношения с поставщиком.
CRAWL_DELAY_SECONDS=1.5

# Выполнять JavaScript. Открывать страницы в настоящем браузере. Нужно для сайтов, где каталог подгружается скриптами. Требует установленного playwright.
# Рекомендация: Включайте выборочно: браузер в десятки раз медленнее и потребляет сотни мегабайт на вкладку.
CRAWL_RENDER_JS=False

# Соблюдать robots.txt. Уважать запреты сайта на автоматический обход.
# Рекомендация: Оставьте включённым. В России robots.txt не имеет силы закона, но его игнорирование суд может счесть недобросовестностью.
CRAWL_RESPECT_ROBOTS=True

# Поиск в интернете. Чем искать, когда в базе ответа нет.
# Рекомендация: yandex — единственный вариант с рублёвой оплатой и закрывающими документами для российского юрлица. searxng — бесплатный запасной.
# Варианты: none, yandex, searxng, tavily
WEB_SEARCH_PROVIDER=none

# Домены для поиска. Ограничить поиск сайтами партнёров. Пусто — искать по всему интернету.
# Рекомендация: Перечислите сайты производителей: ответ из случайного блога хуже честного «не знаю».
WEB_SEARCH_DOMAINS=


# ==== Локальные модели ============================================
# Папка для весов моделей. Куда скачиваются файлы моделей. Одна языковая модель на 32 миллиарда параметров занимает 18–22 гигабайта.
# Рекомендация: Отдельный диск или раздел с запасом от 200 ГБ, если планируете держать несколько моделей.
MODELS_DIR=./data/models

# Зеркало площадки моделей. Адрес зеркала для скачивания весов. Основная площадка из России напрямую недоступна.
# Рекомендация: Укажите доступное вам зеркало либо настройте прокси. Без этого загрузка моделей не пойдёт.
HF_MIRROR=

# Порт сервера модели. На каком порту поднимается локальный сервер с совместимым интерфейсом.
# Рекомендация: Любой свободный. Ассистент пропишет адрес в настройки сам.
LOCAL_MODEL_PORT=8000

# Доля видеопамяти под модель. Какую часть видеопамяти отдать языковой модели.
# Рекомендация: 0.90, если карты заняты только ею. Снижайте до 0.70, если на тех же картах работают эмбеддер, распознавание речи и модель зрения.
LOCAL_MODEL_GPU_FRACTION=0.9

# Длина контекста при запуске. Сколько токенов модель принимает за раз. Чем больше, тем больше видеопамяти уходит на кэш.
# Рекомендация: 32768 хватает с запасом: в промпт идёт около четырёх тысяч токенов. Увеличение до 131072 может съесть несколько гигабайт впустую.
LOCAL_MODEL_CONTEXT=32768

# Поднимать модель при старте. Запускать сервер модели автоматически вместе с ассистентом.
# Рекомендация: Включайте, когда модель выбрана окончательно. Загрузка весов занимает несколько минут, всё это время бот будет отвечать с ошибкой.
LOCAL_MODEL_AUTOSTART=False


# ==== Метрики =====================================================
# Собирать метрики. Записывать нагрузку сервера, обращения к моделям и задержки по этапам.
# Рекомендация: Включено. Накладные расходы незаметны, а без истории разбирать жалобы на медленную работу нечем.
METRICS_ENABLED=True

# Интервал снятия показаний, секунд. Как часто опрашивать процессор, память, диск и видеокарты.
# Рекомендация: 30 секунд — разумный баланс. Для отладки можно поставить 5.
METRICS_INTERVAL_SECONDS=30

# Хранить историю, суток. Через сколько суток удалять старые показания.
# Рекомендация: 30 для обычной эксплуатации, 90 если нужны сезонные сравнения.
METRICS_KEEP_DAYS=30

# Цена входных токенов, ₽ за миллион. Используется для подсчёта расходов в статистике.
# Рекомендация: Для GigaChat Max это 650 рублей за миллион. Для локальной модели поставьте 0 — тогда статистика покажет чистую экономию.
COST_INPUT_PER_MTOK=650.0

# Цена выходных токенов, ₽ за миллион. Отдельная цена для сгенерированных токенов.
# Рекомендация: У части провайдеров выход дороже входа в несколько раз — сверьтесь с тарифом.
COST_OUTPUT_PER_MTOK=650.0


# ==== Логирование =================================================
# Подробность в консоли. Что показывать в окне запуска.
# Рекомендация: INFO при обычной работе. TRACE включайте только на время разбора конкретной проблемы: он выводит каждый найденный фрагмент.
# Варианты: TRACE, DEBUG, INFO, WARNING, ERROR
LOG_LEVEL_CONSOLE=INFO

# Подробность в файле. Что писать в файл журнала.
# Рекомендация: DEBUG: файл ротируется, места не жалко, а при разборе инцидента подробности будут под рукой.
# Варианты: TRACE, DEBUG, INFO, WARNING, ERROR
LOG_LEVEL_FILE=DEBUG

# Формат записей. Человекочитаемый или машинный формат.
# Рекомендация: human для чтения глазами, json — если журналы собираются во внешнюю систему.
# Варианты: human, json
LOG_FORMAT=human

# Размер файла журнала, МБ. При достижении этого размера файл закрывается и начинается новый.
# Рекомендация: 50 МБ и пять запасных копий покрывают неделю активной работы.
LOG_MAX_MB=50

# Сколько старых файлов хранить. Число архивных копий журнала.
# Рекомендация: 5. Больше нужно, только если требуется хранить историю по регламенту.
LOG_BACKUPS=5

# Скрывать чувствительное. Вырезать из журнала токены, ключи, телефоны, почту и адреса.
# Рекомендация: Включено всегда. Журналы часто пересылают в переписке, и утечка токена бота происходит именно так.
LOG_MASK_SENSITIVE=True

# Записывать тексты вопросов. Сохранять полный текст вопросов и расшифровок голосовых сообщений.
# Рекомендация: Выключено по умолчанию: это персональные данные. Включайте только на время разбора и с ограниченным доступом к файлам.
LOG_PAYLOADS=False


# ==== Голос =======================================================
# Распознавание голосовых сообщений. Чем расшифровывать голосовые сообщения, присланные в Telegram.
# Рекомендация: gigaam для чистой речи — она обучалась на русском изначально. faster-whisper устойчивее на записях с шумом. На коротком сообщении любая из них укладывается в секунду.
# Варианты: none, faster-whisper, whisper, gigaam, yandex, sber
VOICE_STT_PROVIDER=none

# Синтез речи. Чем озвучивать ответы.
# Рекомендация: silero: работает на процессоре, хорошее русское произношение, лицензия допускает использование в компании. Облачные варианты звучат живее и поддерживают разметку пауз.
# Варианты: none, silero, piper, yandex, sber, clone
VOICE_TTS_PROVIDER=none

# Голос по умолчанию. Кто озвучивает ответы.
# Рекомендация: Список доступных голосов — в разделе «Голос и АТС».
VOICE_TTS_SPEAKER=baya

# Когда отвечать голосом. Всегда, только в ответ на голосовое сообщение, или никогда.
# Рекомендация: on_voice. Голосовой ответ на текстовый вопрос раздражает: в открытом офисе его неудобно слушать, а цифры и артикулы на слух не воспринимаются и не копируются.
# Варианты: never, on_voice, always
VOICE_REPLY_MODE=on_voice

# Предел озвучиваемого текста. Сколько символов озвучивать. Остальное отправляется текстом.
# Рекомендация: 900 символов — это примерно 40 секунд речи. Дольше слушать тяжело.
VOICE_MAX_CHARS=900

# Движок клонирования голоса. Чем создавать голос по образцу записи.
# Рекомендация: Сначала разберитесь с правовой стороной. Голос — биометрические персональные данные, нужно отдельное письменное согласие. Кроме того, XTTS распространяется по некоммерческой лицензии и в работе компании применяться не может.
# Варианты: none, f5, xtts, openvoice
VOICE_CLONE_PROVIDER=none

# Согласие на клонирование получено. Подтверждение, что письменное согласие сотрудника оформлено.
# Рекомендация: Ставьте только после того, как документ подписан и лежит у вас. Формулировка должна прямо упоминать обучение модели синтеза речи.
VOICE_CLONE_CONSENT=False


# ==== Телефония ===================================================
# Способ подключения к АТС. ari — ассистент работает как приложение Asterisk, аудио идёт через AudioSocket. sip — ассистент регистрируется как обычный аппарат.
# Рекомендация: ari, если есть доступ к настройке Asterisk: он асинхронный и лучше переносит задержки моделей. sip требует сборки библиотеки pjsua2.
# Варианты: none, ari, sip
SIP_MODE=none

# Адрес интерфейса Asterisk. Где слушает REST-интерфейс АТС.
# Рекомендация: Обычно порт 8088 на том же сервере. Включается в http.conf и ari.conf.
ARI_URL=http://127.0.0.1:8088

# Пользователь Asterisk. Логин из ari.conf.
# Рекомендация: Заведите отдельного пользователя только для ассистента.
ARI_USER=

# Пароль Asterisk. Пароль из ari.conf.
# Рекомендация: Длинный случайный. АТС часто доступна из локальной сети целиком.
ARI_PASSWORD=

# Адрес АТС. Куда регистрироваться в режиме sip.
# Рекомендация: Адрес или имя сервера Asterisk.
SIP_SERVER=

# Внутренний номер. Логин SIP-учётной записи ассистента.
# Рекомендация: Выделите отдельный номер, например 1000.
SIP_USER=

# Пароль SIP. Пароль учётной записи.
# Рекомендация: Длинный случайный.
SIP_PASSWORD=

# Порт для звука. Куда Asterisk отдаёт звуковой поток.
# Рекомендация: Любой свободный, доступный с сервера АТС.
AUDIOSOCKET_PORT=8090

# Приветствие. Что ассистент говорит при ответе на звонок.
# Рекомендация: Коротко. Длинное приветствие раздражает при повторных звонках.
SIP_GREETING=Здравствуйте! Задайте вопрос по базе знаний после сигнала.

# Предел длительности звонка, секунд. После этого времени разговор завершается.
# Рекомендация: 600 секунд. Защита от забытой трубки.
SIP_MAX_CALL_SECONDS=600


# ==== Распознавание сканов ========================================
# Чем распознавать сканы. Сертификаты и декларации лежат сканами: текстового слоя в них нет, и для поиска этих документов не существует. Это как раз то, за чем обращаются чаще всего.
# Рекомендация: vlm со зрительной моделью (Qwen3-VL) — лучшее качество на печатях и таблицах и самая надёжная кириллица; модель можно поднять на своих картах, тогда сканы не покидают периметр. tesseract бесплатен и работает офлайн, но ему обязательно нужен языковой пакет rus: без него русский текст выйдет латиницей.
# Варианты: none, tesseract, vlm, yandex
OCR_PROVIDER=none

# Проверка подмены кириллицы латиницей. Часть распознавателей выдаёт «MOCKBA» вместо «МОСКВА» — буквы выглядят одинаково, но это латиница. Текст кажется правильным, а документ теряется навсегда: по запросу «Москва» он не найдётся. Проверка чинит такие слова и отбраковывает страницы, где исправить нельзя.
# Рекомендация: Держите включённой всегда. Для базы с русскими артикулами выключать эту проверку нельзя.
OCR_CYRILLIC_GUARD=True

# Порог подозрительных слов. Какую долю слов с непонятной латиницей ещё можно считать нормой. Выше порога страница уходит запасному распознавателю.
# Рекомендация: 0.08. В базе всегда есть настоящие латинские названия брендов, поэтому ноль ставить нельзя.
OCR_MAX_LATIN_RATIO=0.08

# Порог качества документа. Документ с оценкой ниже остаётся в очереди: текст в индекс попадёт, но при появлении более точного распознавателя документ будет обработан заново.
# Рекомендация: 0.6. Ниже 0.4 ставить не стоит — в индекс пойдёт мусор.
OCR_MIN_QUALITY=0.6

# Запасные распознаватели. Через запятую. Если основной провайдер не прошёл проверку на подмену букв, страница переотправляется этим.
# Рекомендация: tesseract как запасной к vlm: если внешний сервис недоступен, документ всё равно будет распознан.
OCR_FALLBACK=

# Разрешение растеризации, точек на дюйм. С каким разрешением превращать страницу PDF в картинку.
# Рекомендация: 300 — компромисс качества и времени. 400–600 имеет смысл только для мелкого шрифта в таблицах, время растёт квадратично.
OCR_DPI=300

# Максимум страниц на документ. Защита от многосотстраничных сканов.
# Рекомендация: 30 покрывает сертификаты и паспорта целиком.
OCR_MAX_PAGES=30

# Зрительная модель. Имя модели для OCR_PROVIDER=vlm.
# Рекомендация: Qwen3-VL — сильная модель для русских документов. На двух картах по 24 ГБ помещается квантованная версия.
OCR_MODEL=qwen/qwen3-vl-32b-instruct


# ==== Резервные копии =============================================
# Куда складывать копии. Индекс — это часы машинного времени плюс выверенные ответы, накопленные вопросы и обучающие пары. Тексты пересборка вернёт, выверенные ответы — нет.
# Рекомендация: Держите на другом физическом диске, а лучше дополнительно указывайте BACKUP_MIRROR_DIR на сетевую папку.
BACKUP_DIR=./data/backups

# Расписание. Выражение cron: минуты, часы, день месяца, месяц, день недели. Применяется командой python backup.py schedule.
# Рекомендация: 30 3 * * * — каждую ночь в 3:30, когда индексация уже закончилась.
BACKUP_SCHEDULE=30 3 * * *

# Проверять копию сразу после создания. Копия разворачивается во временную папку, база открывается, считаются документы и векторы. Копия, которую ни разу не пробовали восстановить, — это ещё не копия.
# Рекомендация: Включено. Проверка занимает секунды и ловит единственную по-настоящему дорогую ошибку — битый архив, о котором узнают в день аварии.
BACKUP_VERIFY=True

# Хранить ежедневных копий, дней. Свежие копии за каждый день последней недели.
# Рекомендация: 7. Этого хватает, чтобы откатить порчу, замеченную не сразу.
BACKUP_KEEP_DAILY=7

# Хранить недельных копий. Дальше — по одной копии на неделю.
# Рекомендация: 4 недели.
BACKUP_KEEP_WEEKLY=4

# Хранить месячных копий. Ещё дальше — по одной копии на месяц.
# Рекомендация: 6 месяцев.
BACKUP_KEEP_MONTHLY=6

# Вторая копия. Готовый снимок дополнительно кладётся сюда: второй диск, сетевая папка, NAS.
# Рекомендация: Заполните обязательно. Копия на том же диске не спасает от отказа этого диска.
BACKUP_MIRROR_DIR=

# Предупреждать, если копии нет столько часов. Порог, после которого админка показывает предупреждение.
# Рекомендация: 48 часов при ежедневном расписании.
BACKUP_ALERT_HOURS=48


# ==== Модели ======================================================
# Запасные провайдеры генерации. Через запятую. Если основной не ответил — упал сервер модели, кончилась видеопамять, пропал интернет, — ассистент не замолкает, а отвечает следующим. Переключение видно в журнале и в разделе «Модели»: молча переехать на другого провайдера система не должна, потому что меняются и стоимость, и то, куда уходят данные.
# Рекомендация: local основным, gigachat запасным — так обычные вопросы бесплатны и не покидают периметр, а при падении сервера работа не встаёт. Обратный порядок осмыслен, если локальные карты заняты другим.
LLM_FALLBACK=

# Адрес локальной модели. Пусто — адрес берётся у сервера, запущенного из раздела «Модели». Заполнять нужно, только если модель поднята отдельно: LM Studio, Ollama, чужой сервер в локальной сети.
# Рекомендация: Оставьте пустым. Тогда после перезапуска модели на другом порту ничего не сломается.
LOCAL_LLM_BASE_URL=

# Имя локальной модели. Как модель называется на своём сервере. Пусто — берётся имя запущенной модели.
# Рекомендация: Оставьте пустым, если модель запускается из админки.
LOCAL_LLM_MODEL=

# Ожидание ответа локальной модели, секунд. Длинные ответы на своих картах идут дольше облачных.
# Рекомендация: 180 секунд. Меньше ставить не стоит: первый запрос после запуска модели всегда медленный.
LOCAL_LLM_TIMEOUT=180.0


# ==== Безопасность ================================================
# Сколько живёт вход в админку, часов. После этого нужно войти заново.
# Рекомендация: 12 часов — рабочий день. Для доступа снаружи ставьте 2–4.
ADMIN_SESSION_HOURS=12

# Файл ключей и токенов. Ключи хранятся отдельно от остальных настроек: этот файл имеет права 600 и не попадает ни в архив обновления, ни в резервную копию, в отличие от .env.
# Рекомендация: Оставьте рядом с программой. Перенести ключи туда можно кнопкой в разделе «Безопасность».
SECRETS_FILE=./secrets.env

# Команда получения ключей. Любая команда, печатающая строки вида KEY=VALUE. Через неё подключается внешнее хранилище секретов: vault, менеджер паролей, systemd-credentials.
# Рекомендация: Правильный способ хранения ключей в проде. Шифрование файла своими силами смысла не имеет: ключ шифрования пришлось бы держать рядом.
SECRETS_CMD=

# Вопросов от одного сотрудника в час. Защита от случайного скрипта и от того, что один человек израсходует общий бюджет на модель за вечер. Администраторов не ограничивает.
# Рекомендация: 60 — вчетверо больше, чем задаёт живой человек в самый занятой день. 0 отключает ограничение.
RATE_LIMIT_PER_USER_HOUR=60

# Вопросов от одного сотрудника в сутки. Дневной предел на человека.
# Рекомендация: 300.
RATE_LIMIT_PER_USER_DAY=300

# Вопросов всего в сутки. Общий предел: страховка бюджета на облачные модели.
# Рекомендация: Считайте по цене: 3000 вопросов при средней длине ответа — это примерно недельный расход небольшого отдела.
RATE_LIMIT_TOTAL_DAY=3000

# Защита от подмены инструкций. Сотрудник может прислать сообщение, составленное так, чтобы бот выдал содержимое недоступного ему раздела. Подозрительные обороты в вопросе обезвреживаются, а готовый ответ проверяется на то, что в нём нет текста из закрытых разделов. Вторая проверка важнее: она смотрит на результат, а не на формулировку.
# Рекомендация: Включено. Обычные формулировки вроде «забудь про Grundfos, меня интересует Wilo» она не трогает.
PROMPT_GUARD=True

# Срок хранения вопросов, дней. Тексты вопросов — персональные данные. По истечении срока они удаляются вместе с оценками. Выверенные ответы и обучающие пары не трогаются никогда: это результат работы экспертов.
# Рекомендация: 365 дней для отдела. 0 означает «хранить бессрочно» — так делать не стоит, это решение нужно принимать осознанно.
RETENTION_QUERIES_DAYS=365

# Срок хранения цепочек разбора, дней. В цепочке есть текст вопроса и куски документов. Она нужна для разбора свежих жалоб, а не как архив.
# Рекомендация: 90 дней.
RETENTION_TRACES_DAYS=90


# ==== Оповещения ==================================================
# Сообщать о проблемах. Проверка раз в час: нет свежей копии, кончается диск, упал сервер модели, растёт очередь распознавания, много отказов. Смысл в том, чтобы узнать раньше, чем сообщит сотрудник.
# Рекомендация: Включено.
ALERTS_ENABLED=True

# Куда сообщать. Через запятую: telegram (администраторам из TELEGRAM_ADMIN_IDS), webhook, log.
# Рекомендация: telegram — единственный канал, который читают. log оставьте как запасной: если Telegram недоступен, сообщение всё равно сохранится.
ALERT_CHANNELS=telegram

# Как часто напоминать о том же. Одна незакрытая проблема не должна заглушать все остальные.
# Рекомендация: 12 часов.
ALERT_REPEAT_HOURS=12

# Порог свободного места, ГБ. Ниже этого — сообщение. Индекс, копии и распакованные архивы растут незаметно.
# Рекомендация: 10 ГБ для базы вашего размера.
ALERT_DISK_FREE_GB=10

# Порог доли отказов. Если за сутки больше этой доли вопросов осталось без ответа — сообщение. Обычно это значит, что сломался поиск или в базу начали спрашивать про то, чего в ней нет.
# Рекомендация: 0.35. Считается только при двадцати вопросах и больше.
ALERT_REFUSAL_RATE=0.35


# ==== Хранилище ===================================================
# Где лежат векторы. numpy — файл рядом с индексом: просто, быстро, ничего не нужно поднимать. qdrant — отдельный сервис: переживает параллельную запись, не держит всё в памяти и умеет отбирать по разделу внутри поиска, а не после него.
# Рекомендация: numpy до сотен тысяч фрагментов. Переходить на qdrant стоит, когда база перестаёт помещаться в память или когда бот и индексация начинают мешать друг другу. Разворачивается одним контейнером, перенос — командой python vectors_qdrant.py migrate.
# Варианты: numpy, qdrant
VECTOR_BACKEND=numpy

# Адрес Qdrant. Куда обращаться за векторами.
# Рекомендация: Локальный адрес, если контейнер поднят на том же сервере.
QDRANT_URL=http://127.0.0.1:6333

# Имя коллекции. Одна коллекция на один индекс. Для тестового и рабочего контуров имена должны различаться.
# Рекомендация: kb_chunks для рабочего, kb_chunks_test для проверок.
QDRANT_COLLECTION=kb_chunks

# Ключ Qdrant. Нужен, если Qdrant доступен не только с локального адреса.
# Рекомендация: Обязателен, как только сервис выходит за пределы машины.
QDRANT_API_KEY=

# Телеметрия в отдельной базе. Метрики сервера и журнал пишутся постоянно, а с документами никогда не соединяются. В отдельном файле они не конкурируют за блокировку с индексацией и с ответами бота.
# Рекомендация: Включено. Выключать имеет смысл только при разборе проблем, когда удобнее держать всё в одном файле.
TELEMETRY_SEPARATE=True

# Ожидание блокировки базы, мс. Сколько ждать освобождения базы, прежде чем признать неудачу. Короткие пересечения при параллельной работе неизбежны, и правильная реакция на них — подождать, а не упасть.
# Рекомендация: 15000. Увеличивайте, если в журнале появляются сообщения «database is locked» во время индексации.
DB_BUSY_TIMEOUT_MS=15000


# ==== Трассировка =================================================
# Сохранять цепочки ответов. Полная цепочка одного ответа: что нашёл каждый канал с какими оценками, что сделало переранжирование, какой текст ушёл в модель и что она вернула. Без этого разбор жалобы «бот ответил неправильно» сводится к попыткам воспроизвести случай на уже изменившемся индексе.
# Рекомендация: Включено. Записи живут в базе телеметрии и в резервные копии индекса не попадают.
TRACE_ENABLED=True

# Сколько цепочек хранить. Старые удаляются автоматически. В цепочке есть текст вопроса — это персональные данные, хранить их бессрочно неправильно.
# Рекомендация: 3000 покрывает несколько недель работы отдела.
TRACE_KEEP=3000

# Сохранять текст запроса к модели. Самая полезная часть при разборе: видно, что именно модель прочитала. Занимает больше места и содержит куски документов.
# Рекомендация: Включено. Выключайте, если политика запрещает хранить содержимое документов в оперативных данных.
TRACE_PROMPT=True


# ==== Слежение за папкой ==========================================
# Интервал проверки, секунд. Как часто обходить папку в поисках изменений.
# Рекомендация: 300 секунд для рабочего дня. Если установлен watchdog, изменения ловятся мгновенно, а обход остаётся подстраховкой.
WATCH_INTERVAL_SECONDS=300

# Сообщать об изменениях структуры. Отправлять администраторам уведомление, когда появляются, исчезают или переименовываются папки.
# Рекомендация: Включено. Структура папок определяет права доступа и тип документа — неожиданная папка означает, что документы в ней получат неверные метаданные.
WATCH_NOTIFY_STRUCTURE=True

# Пересобирать граф после обновления. Обновлять граф связности после каждой переиндексации.
# Рекомендация: Выключено: на большой базе построение занимает время. Стройте по кнопке, когда нужно посмотреть.
WATCH_REBUILD_GRAPH=False


# ==== Админка =====================================================
# Адрес админки. На каком адресе слушать веб-интерфейс администратора.
# Рекомендация: 127.0.0.1 — доступ только с самого сервера. Наружу выставляйте только через обратный прокси с авторизацией.
ADMIN_HOST=127.0.0.1

# Порт админки. Порт веб-интерфейса.
# Рекомендация: Любой свободный.
ADMIN_PORT=8800

# Пароль админки. Строка, которую нужно ввести для доступа. Пусто — без пароля.
# Рекомендация: Обязательно задайте, если админка доступна не только с localhost.
ADMIN_TOKEN=

