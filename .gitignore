# Индекс и всё, что пересобирается. Гигабайты, которые не нужны в истории:
# индекс восстанавливается из документов, а копия — из backup.py.
data/
logs/
*.sqlite3
*.sqlite3-*
*.npz

# Настройки конкретной установки: у каждой машины свои пути и ключи.
# Образец лежит в .env.example и в историю попадает.
.env
secrets.env

# Ключи и токены — не в репозитории никогда.
*.pem
*.key

# Контрольные вопросы — рабочие данные компании, а не код.
eval/golden.jsonl

# Служебное
__pycache__/
*.pyc
.DS_Store
venv/
.venv/
